{
	"name": "{{ tmplr.project_name }}",
	"version": "0.0.0",
	"description": "{{ tmplr.project_description }}",
	"keywords": [
		"cli",
		"cli-app",
		"command-line"
	],
	"license": "MIT",
	"repository": "tommy-mitchell/{{ tmplr.project_name | skip: @tommy-mitchell/ }}",
	"author": {
		"name": "Tommy Mitchell",
		"url": "https://tommymitchell.io"
	},
	"type": "module",
	"bin": {
		"{{ tmplr.command_name }}": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": "^18.19 || ^20.8 || >=21"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc -p tsconfig.build.json && execify --all",
		"lint": "xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && tsc --noEmit"
	},
	"ava": {
		"extensions": {
			"ts": "module"
		},
		"environmentVariables": {
			"concurrency": "5"
		},
		"nodeArguments": [
			"--import=tsimp"
		]
	},
	"dependencies": {
		"meow": "^13.2.0"
	},
	"devDependencies": {
		"@shopify/semaphore": "^3.1.0",
		"@tommy-mitchell/dprint-config": "^0.4.0",
		"@tommy-mitchell/eslint-config-xo": "^0.7.0",
		"@tommy-mitchell/tsconfig": "^2.1.0",
		"@types/node": "18.19",
		"ava": "^6.1.3",
		"c8": "^10.1.2",
		"execify-cli": "beta",
		"execa": "^9.3.1",
		"get-executable-bin-path": "^0.1.0",
		"tsimp": "^2.0.11",
		"type-fest": "^4.25.0",
		"typescript": "~5.5.4",
		"xo": "^0.59.3"
	}
}
